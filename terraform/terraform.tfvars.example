aws_region  = "ap-south-1"
project_name = "aws-devops-incident-platform"
environment  = "dev"

# Start with the public demo image. After building the application,
# replace this with the ECR image URI.
container_image = "public.ecr.aws/docker/library/nginx:alpine"

desired_count  = 1
max_task_count = 4

# RDS costs money. Keep false until you need the database scenario.
enable_rds = false

# Never commit a real password.
# db_password = "CHANGE-ME"
